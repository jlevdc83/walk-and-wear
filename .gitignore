.DS_Store

# Session transcript: contains home network detail (Pi tailnet address, LAN
# subnet, MAC addresses, HOOBS layout). Keep it local — do not publish.
session-export/

# Dev-only tooling pulled in for one-off measurements (pngjs, playwright helpers).
# Nothing here is a runtime dependency — the app is dependency-free by design.
node_modules/
package-lock.json

# Agent worktrees. Registered with git worktree, so a real tree rather than junk —
# but scratch space, and committing it would put a copy of the repo inside the repo.
.claude/worktrees/
